# ── Production Backend Dockerfile ─────────────────────────────────
# Optimized for Render free tier:
# - Multi-stage build (smaller image)
# - Non-root user (security)
# - No --reload (performance)
# - Health check built in

FROM python:3.12-slim AS builder

WORKDIR /build

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps
COPY pyproject.toml ./
RUN pip install --no-cache-dir --prefix=/install .

# ── Production stage ──────────────────────────────────────────────

FROM python:3.12-slim

WORKDIR /app

# Security: create non-root user
RUN groupadd -r edtech && useradd -r -g edtech -s /bin/false edtech

# Runtime system deps only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application code
COPY . .

# Own the app directory
RUN chown -R edtech:edtech /app

# Switch to non-root user
USER edtech

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run migrations then start production server
# - Workers: 2 (Render free has 512MB RAM)
# - No --reload in production
CMD ["sh", "-c", "python -m alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2 --log-level warning"]

EXPOSE 8000
